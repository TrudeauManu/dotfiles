! X colors.
! Generated by 'wal'
*foreground:        #cde0e7
*background:        #14151e
*.foreground:       #cde0e7
*.background:       #14151e
emacs*foreground:   #cde0e7
emacs*background:   #14151e
URxvt*foreground:   #cde0e7
XTerm*foreground:   #cde0e7
UXTerm*foreground:  #cde0e7
URxvt*background:   [100]#14151e
XTerm*background:   #14151e
UXTerm*background:  #14151e
URxvt*cursorColor:  #cde0e7
XTerm*cursorColor:  #cde0e7
UXTerm*cursorColor: #cde0e7
URxvt*borderColor:  [100]#14151e

! Colors 0-15.
*.color0: #14151e
*color0:  #14151e
*.color1: #837C8F
*color1:  #837C8F
*.color2: #7B859E
*color2:  #7B859E
*.color3: #7EA3C1
*color3:  #7EA3C1
*.color4: #8896B2
*color4:  #8896B2
*.color5: #8FB1D6
*color5:  #8FB1D6
*.color6: #94C9E5
*color6:  #94C9E5
*.color7: #cde0e7
*color7:  #cde0e7
*.color8: #8f9ca1
*color8:  #8f9ca1
*.color9: #837C8F
*color9:  #837C8F
*.color10: #7B859E
*color10:  #7B859E
*.color11: #7EA3C1
*color11:  #7EA3C1
*.color12: #8896B2
*color12:  #8896B2
*.color13: #8FB1D6
*color13:  #8FB1D6
*.color14: #94C9E5
*color14:  #94C9E5
*.color15: #cde0e7
*color15:  #cde0e7

! Black color that will not be affected by bold highlighting.
*.color66: #14151e
*color66:  #14151e

! Xclock colors.
XClock*foreground: #cde0e7
XClock*background: #14151e
XClock*majorColor:  rgba:cd/e0/e7/ff
XClock*minorColor:  rgba:cd/e0/e7/ff
XClock*hourColor:   rgba:cd/e0/e7/ff
XClock*minuteColor: rgba:cd/e0/e7/ff
XClock*secondColor: rgba:cd/e0/e7/ff

! Set depth to make transparency work.
URxvt*depth: 32
